{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "ES2016",
    "module": "commonjs",
    "allowJs": true,
    "outDir": "./lib",
    "rootDir": "./",
    "removeComments": false,
    "strict": true,
    "moduleResolution": "node",
    "typeRoots": [
      "./typings",
      "./node_modules/@types"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./src/**/*",
    "./test/**/*"
  ],
  "exclude": [
    "node_modules",
    "typings",
    "./src/public/*"
  ]
}