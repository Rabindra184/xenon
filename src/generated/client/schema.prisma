generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "darwin", "darwin-arm64", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Build {
  id        String    @id @default(uuid())
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
}

model Session {
  id                      String       @id
  build_id                String?
  name                    String?
  status                  String       @default("running")
  desired_capabilities    String
  session_capabilities    String
  node_id                 String
  has_live_video          Boolean
  video_recording_enabled Boolean      @default(true)
  video_recording         String?
  startTime               DateTime     @default(now())
  endTime                 DateTime?
  failure_reason          String?
  is_profiling_available  Boolean      @default(false)
  device_info             String?
  device_udid             String
  device_platform         String
  device_version          String
  device_name             String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  performance_trace       String?      @map("performance_trace")
  failure_category        String?
  ai_analysis             String?
  tags                    String?
  trace_id                String?
  last_heartbeat_at       DateTime?
  heartbeat_pid           Int?
  heartbeat_host          String?
  api_key_id              String?
  Log                     Log[]
  Profiling               Profiling[]
  build                   Build?       @relation(fields: [build_id], references: [id])
  SessionLog              SessionLog[]
  Recording               Recording[]

  @@index([status, last_heartbeat_at])
  @@index([build_id])
  @@index([device_udid])
  @@index([device_platform, status])
  @@index([api_key_id])
}

model SessionLog {
  id                 String   @id @default(uuid())
  session_id         String
  command_name       String?
  url                String
  method             String
  title              String
  subtitle           String?
  body               String?
  response           String
  screenshot         String?
  is_success         Boolean?
  is_error           Boolean  @default(false)
  is_healed          Boolean  @default(false)
  original_selector  String?
  healed_selector    String?
  healing_confidence Float?
  healing_tier       String?
  original_strategy  String?
  healed_strategy    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  duration           Int?
  span_id            String?
  trace_id           String?
  session            Session  @relation(fields: [session_id], references: [id])

  @@index([original_strategy, original_selector, createdAt])
}

model Log {
  id         String   @id @default(uuid())
  session_id String
  log_type   String
  message    String
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  session    Session  @relation(fields: [session_id], references: [id])
}

model Profiling {
  id                Int      @id @default(autoincrement())
  session_id        String
  cpu               String?
  memory            String?
  total_cpu_used    String?
  total_memory_used String?
  raw_cpu_log       String?
  raw_memory_log    String?
  timestamp         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  session           Session  @relation(fields: [session_id], references: [id])
}

model App {
  id          String   @id @default(uuid())
  name        String
  filename    String
  filepath    String
  mimetype    String
  size        Int
  packageName String?
  version     String?
  platform    String?
  md5         String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Device {
  udid                         String
  host                         String
  systemPort                   Int?
  proxyPort                    Int?
  proxyHost                    String?
  wdaLocalPort                 Int?
  name                         String?  @default("unknown")
  state                        String?  @default("available")
  sdk                          String?  @default("unknown")
  platform                     String?  @default("unknown")
  deviceType                   String?  @default("real")
  busy                         Boolean? @default(false)
  userBlocked                  Boolean? @default(false)
  realDevice                   Boolean? @default(true)
  session_id                   String?
  offline                      Boolean? @default(false)
  mjpegServerPort              Int?
  lastCmdExecutedAt            Float?
  totalUtilizationTimeMilliSec Float    @default(0)
  sessionStartTime             Float    @default(0)
  newCommandTimeout            Int?
  cloud                        String?
  derivedDataPath              String?
  chromeDriverPath             String?
  capability                   String?
  adbRemoteHost                String?
  adbPort                      Int?
  nodeId                       String?
  screenWidth                  String?
  screenHeight                 String?
  dashboard_link               String?
  total_session_count          Int?     @default(0)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  healthCheckError             String?
  healthStatus                 String?  @default("Healthy")
  lastHealthCheckAt            Float?
  batteryLevel                 Int?
  reservationReason            String?
  reservedBy                   String?
  reservedUntil                Float?
  storageFree                  String?
  tags                         String?
  thermalStatus                String?
  sessionProgress              String?  @default("")
  totalHealedCount             Int?     @default(0)
  ip                           String?  @default("")
  cpuArchitecture              String?
  owningSessionId              String?  @map("owning_session_id")
  lockedAt                     Float?   @map("locked_at")
  teamId                       String?
  team                         Team?    @relation(fields: [teamId], references: [id])

  @@id([udid, host])
  @@index([owningSessionId])
  @@index([teamId])
}

model PendingSession {
  id            Int    @id @default(autoincrement())
  capability_id String @unique
  capability    String
  createdAt     Float
}

model CLIArgs {
  id        Int      @id @default(autoincrement())
  args      String
  createdAt DateTime @default(now())
}

model WebhookConfig {
  id              String   @id @default(uuid())
  url             String
  type            String   @default("slack")
  events          String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payloadTemplate String?
}

model WebConfig {
  id        String   @id @default("global")
  name      String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocatorEtalon {
  id         String   @id @default(uuid())
  selector   String   @unique
  strategy   String
  attributes String
  nodeName   String
  lastSeen   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PortLease {
  port         Int     @id
  purpose      String
  leasedToUdid String
  leasedToHost String  @default("")
  leaseId      String?
  leasedToPid  Int?
  leasedAt     Float
  expiresAt    Float

  @@index([purpose, expiresAt])
  @@index([leasedToUdid])
  @@index([leaseId])
  @@index([expiresAt])
}

model Lease {
  id               String   @id @default(cuid())
  tokenHash        String
  deviceUdid       String
  deviceHost       String
  actorId          String
  teamId           String?
  buildId          String?
  reason           String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  expiresAt        Float
  heartbeatSeconds Int      @default(30)
  lastHeartbeatAt  Float
  allocatedPorts   String
  capabilityBag    String

  @@index([status, expiresAt])
  @@index([status, lastHeartbeatAt, heartbeatSeconds])
  @@index([actorId])
  @@index([deviceUdid, deviceHost])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  scopes     String
  rateLimit  Int       @default(300)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  teamId     String?
  role       String    @default("member")
  team       Team?     @relation(fields: [teamId], references: [id])

  // NEW
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  devices   Device[]
  apiKeys   ApiKey[]
  members   TeamMember[]
}

model SelectorState {
  id                 String    @id @default(uuid())
  original_strategy  String
  original_selector  String
  status             String
  fixed_at           DateTime?
  fixed_by_api_key   String?
  resolved_at        DateTime?
  muted_at           DateTime?
  muted_by_api_key   String?
  regression_count   Int       @default(0)
  clean_builds_count Int       @default(0)
  last_event_at      DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([original_strategy, original_selector])
  @@index([status])
  @@index([fixed_at])
}

model Recording {
  id              String       @id @default(uuid())
  group_id        String
  device_udid     String
  device_host     String       @default("127.0.0.1")
  session_id      String?
  started_at      DateTime
  ended_at        DateTime?
  status          String
  file_path       String
  duration_ms     Int?
  size_bytes      Int?
  device_snapshot String?
  fail_reason     String?
  bookmarks       Bookmark[]
  annotations     Annotation[]
  Session         Session?     @relation(fields: [session_id], references: [id])

  @@index([group_id])
  @@index([device_udid])
  @@index([started_at])
}

model Bookmark {
  id           String    @id @default(uuid())
  recording_id String
  timecode_ms  Int
  label        String
  note         String?
  created_at   DateTime  @default(now())
  Recording    Recording @relation(fields: [recording_id], references: [id], onDelete: Cascade)

  @@index([recording_id, timecode_ms])
}

model Annotation {
  id           String    @id @default(uuid())
  recording_id String
  timecode_ms  Int
  shape        String
  geometry     String
  color        String
  text         String?
  author       String?
  created_at   DateTime  @default(now())
  Recording    Recording @relation(fields: [recording_id], references: [id], onDelete: Cascade)

  @@index([recording_id, timecode_ms])
}

// NOTE: SQLite does not support Prisma enums. UserRole / UserStatus are
// modeled as TypeScript string-literal types in the application layer and
// stored as plain TEXT here. Allowed values:
//   role:   "SUPER_ADMIN" | "ADMIN" | "MEMBER"   (default "MEMBER")
//   status: "ACTIVE" | "INACTIVE"                (default "ACTIVE")
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  passwordHash      String
  accessKey         String    @unique
  role              String    @default("MEMBER")
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  apiKeys             ApiKey[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  teamMemberships     TeamMember[]
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipHash     String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model TeamMember {
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

model EventLog {
  id            String   @id @default(cuid())
  type          String
  payload       String // JSON string — portable, no SQLite-isms
  correlationId String?
  teamId        String?
  occurredAt    DateTime @default(now())

  @@index([type, occurredAt])
  @@index([occurredAt])
}
