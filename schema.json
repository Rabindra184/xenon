{
    "$schema": "http://json-schema.org/draft-07/schema",
    "additionalProperties": false,
    "description": "Appium configuration schema for the Xenon plugin.",
    "properties": {
        "platform": {
            "type": "string",
            "enum": [
                "ios",
                "android",
                "both"
            ],
            "default": "both"
        },
        "androidDeviceType": {
            "type": "string",
            "enum": [
                "both",
                "real",
                "simulated"
            ],
            "default": "both"
        },
        "simulators": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": true
            },
            "default": []
        },
        "iosDeviceType": {
            "type": "string",
            "enum": [
                "both",
                "real",
                "simulated"
            ],
            "default": "both"
        },
        "hub": {
            "type": "string"
        },
        "remoteMachineProxyIP": {
            "type": "string"
        },
        "adbRemote": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": []
        },
        "skipChromeDownload": {
            "type": "boolean",
            "default": true
        },
        "maxSessions": {
            "type": "number",
            "default": 8
        },
        "cloud": {
            "type": "object",
            "additionalProperties": true,
            "description": "Cloud configuration object. Contains 'url', 'apiKey', 'devices' list, etc. Should be provided via config file."
        },
        "derivedDataPath": {
            "type": "object",
            "additionalProperties": true,
            "description": "Map of derived data paths for iOS simulators/devices."
        },
        "emulators": {
            "type": "array",
            "items": {
                "type": "object"
            },
            "default": []
        },
        "proxy": {
            "type": "object",
            "additionalProperties": true,
            "description": "Proxy configuration object. Contains 'host', 'port', 'auth', 'protocol'."
        },
        "deviceAvailabilityTimeoutMs": {
            "type": "number",
            "default": 300000
        },
        "deviceAvailabilityQueryIntervalMs": {
            "type": "number",
            "default": 10000
        },
        "sendNodeDevicesToHubIntervalMs": {
            "type": "number",
            "default": 30000
        },
        "checkStaleDevicesIntervalMs": {
            "type": "number",
            "default": 30000
        },
        "checkBlockedDevicesIntervalMs": {
            "type": "number",
            "default": 30000
        },
        "newCommandTimeoutSec": {
            "type": "number",
            "default": 60
        },
        "bindHostOrIp": {
            "type": "string",
            "default": "127.0.0.1"
        },
        "enableDashboard": {
            "type": "boolean",
            "default": false
        },
        "bootedSimulators": {
            "type": "boolean",
            "default": false
        },
        "removeDevicesFromDatabaseBeforeRunningThePlugin": {
            "type": "boolean",
            "default": false
        },
        "healthCheckIntervalMs": {
            "type": "number",
            "default": 30000
        },
        "healthCheckSchedule": {
            "type": "string"
        },
        "databaseProvider": {
            "type": "string",
            "enum": [
                "sqlite",
                "postgresql"
            ]
        },
        "databaseUrl": {
            "type": "string"
        },
        "aiProvider": {
            "type": "string",
            "enum": [
                "gemini",
                "openai",
                "anthropic",
                "ollama"
            ]
        },
        "aiModel": {
            "type": "string"
        },
        "aiBaseUrl": {
            "type": "string"
        },
        "geminiApiKey": {
            "type": "string"
        },
        "openaiApiKey": {
            "type": "string"
        },
        "anthropicApiKey": {
            "type": "string"
        },
        "enableSelfHealing": {
            "type": "boolean",
            "default": true
        },
        "buildCleanupDays": {
            "type": "number",
            "default": 30
        },
        "buildCleanupMaxCount": {
            "type": "number",
            "default": 100
        },
        "buildCleanupSchedule": {
            "type": "string",
            "default": "0 0 * * *"
        },
        "deleteBuildAssets": {
            "type": "boolean",
            "default": true
        },
        "sessionHeartbeatIntervalMs": {
            "type": "number",
            "default": 30000
        },
        "enableJsonLogging": {
            "type": "boolean",
            "default": false
        },
        "tlsRejectUnauthorized": {
            "type": "boolean",
            "default": true,
            "description": "Whether to verify TLS certificates for internal outgoing requests. Default is true. Set to false only for dev/test."
        }
    },
    "required": [
        "platform",
        "androidDeviceType",
        "iosDeviceType",
        "skipChromeDownload",
        "maxSessions",
        "deviceAvailabilityTimeoutMs",
        "deviceAvailabilityQueryIntervalMs",
        "sendNodeDevicesToHubIntervalMs",
        "checkStaleDevicesIntervalMs",
        "checkBlockedDevicesIntervalMs",
        "newCommandTimeoutSec",
        "bindHostOrIp",
        "enableDashboard",
        "bootedSimulators",
        "removeDevicesFromDatabaseBeforeRunningThePlugin",
        "healthCheckIntervalMs",
        "enableSelfHealing",
        "buildCleanupDays",
        "buildCleanupMaxCount",
        "buildCleanupSchedule",
        "deleteBuildAssets",
        "sessionHeartbeatIntervalMs",
        "enableJsonLogging"
    ],
    "title": "IPluginArgs",
    "type": "object"
}